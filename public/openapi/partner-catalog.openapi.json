    "/profile/admin/partner-catalog-access": {
      "post": {
        "operationId": "setPartnerCatalogBrandAccess",
        "security": [
          {
            "AdminBearer": []
          }
        ],
        "description": "Requires smartify_admins. Smartify verifies ownership or authorized-supplier evidence for each brand. Brand names selected by a partner in their profile do not grant access. Enabling access requires at least one verified grant. Removing a grant prevents future submissions and approvals for that brand. Server stamps reviewer and time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogBrandAccessRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Catalog brand access saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogBrandAccessResult"
                }
              }
            }
          },
          "400": {
            "description": "Missing organization or access flag",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Admin role required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
