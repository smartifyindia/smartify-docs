    "/devices/partner-submissions/{org_id}/{partner_sku}/approve": {
      "parameters": [
        {
          "name": "org_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "partner_sku",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "description": "Existing normalized partner SKU, including legacy identities. New identities submitted through the API are restricted to 80 characters and letters, digits, dot, underscore or hyphen."
          }
        }
      ],
      "post": {
        "operationId": "approvePartnerCatalogSubmission",
        "security": [
          {
            "AdminBearer": []
          }
        ],
        "description": "Requires Cognito smartify_admins group. Decision, revision history and catalog publication are atomic. Approval rechecks organization and product eligibility. Legacy products without declarations must be resubmitted. An already-pending DELETE can be approved by a platform admin for cleanup after publication access or brand grants are revoked; ownership and transaction guards remain.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResult"
                }
              }
            }
          },
          "400": {
