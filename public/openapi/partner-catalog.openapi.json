{
  "openapi": "3.0.3",
  "info": {
    "title": "Smartify Partner Catalog API",
    "version": "2.0.0",
    "description": "Approval and eligibility milestone. Contract for source changes; deploy with the matching admin frontend. Stock sync and availability endpoints are not part of this version."
  },
  "servers": [
    {
      "url": "https://s6m3hrufxk.execute-api.ap-south-1.amazonaws.com/v1"
    }
  ],
  "paths": {
    "/api/partner-catalog/products": {
      "get": {
        "operationId": "listPartnerCatalogSubmissions",
        "security": [
          {
            "PartnerApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "APPROVED",
                "REJECTED"
              ]
            }
          },
          {
            "name": "history",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include revision history instead of current pointers."
          }
        ],
        "responses": {
          "200": {
            "description": "Submission records; admin responses include the currently published product for comparison",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key or missing identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Partner no longer eligible, or admin role required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Submission not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Submission, catalog or eligibility changed; refresh before retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Product fails listing eligibility or price validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
