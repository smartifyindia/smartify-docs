      "post": {
        "operationId": "submitPartnerProduct",
        "security": [
          {
            "PartnerApiKey": []
          }
        ],
        "description": "Submit an eligible product for human review. A 202 response does not publish a listing. Resubmission creates a new revision; client retries create another revision in this release. Brand/make is mandatory and must match an active Smartify-approved organization brand grant.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued PENDING submission",
